# Lista las impresoras, su dispositivo y si retienen los trabajos por defecto.
# Uso: ipptool -c ipp://localhost/ get-printers.test
{
    OPERATION CUPS-Get-Printers
    GROUP operation-attributes-tag
    ATTR charset attributes-charset utf-8
    ATTR naturalLanguage attributes-natural-language en
    ATTR keyword requested-attributes printer-name,device-uri,job-hold-until-default
    DISPLAY printer-name
    DISPLAY device-uri
    DISPLAY job-hold-until-default
}
